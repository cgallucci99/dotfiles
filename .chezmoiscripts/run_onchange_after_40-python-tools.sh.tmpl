#!/bin/bash
# --managed-python uses uv's own Python, so removing a Homebrew Python can't break these tools.
# --force replaces broken installs and links left behind by an old pipx install.
# Tool list and Python pins live in .chezmoidata/packages.yaml
install() {
  {{ .brewPrefix }}/bin/uv tool install --force --managed-python "$@"
}

failed=()
{{- range $tool, $python := .packages.all.uvTools }}
install {{ if $python }}--python {{ $python }} {{ end }}{{ $tool }} || failed+=({{ $tool }})
{{- end }}

if [ ${#failed[@]} -gt 0 ]; then
  # Exiting non-zero makes chezmoi retry this script on the next apply
  echo "Failed to install: ${failed[*]}" >&2
  exit 1
fi
