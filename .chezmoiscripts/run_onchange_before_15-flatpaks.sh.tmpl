{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -e

# Package lists live in .chezmoidata/packages.yaml
flatpaks=(
{{- range .packages.linux.flatpaks }}
  {{ . }}
{{- end }}
)
{{- if not (lookPath "code") }}
# bazzite-dx ships VS Code natively; otherwise use the Flatpak
flatpaks+=(com.visualstudio.code)
{{- end }}

flatpak install -y --noninteractive flathub "${flatpaks[@]}"
{{ end -}}
