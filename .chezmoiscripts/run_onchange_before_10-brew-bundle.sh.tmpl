{{- $os := get .packages .chezmoi.os -}}
#!/bin/bash
set -e

eval "$({{ .brewPrefix }}/bin/brew shellenv bash)"

# Package lists live in .chezmoidata/packages.yaml
brew bundle --file=/dev/stdin <<BREWFILE
{{- if eq .chezmoi.os "darwin" }}
{{-   range .packages.darwin.taps }}
tap {{ . | quote }}
{{-   end }}
{{- end }}
{{- if .work }}
{{-   range .packages.work.taps }}
tap {{ . | quote }}
{{-   end }}
{{- end }}
{{- range concat .packages.all.brews $os.brews }}
brew {{ . | quote }}
{{- end }}
{{- if .work }}
{{-   range .packages.work.brews }}
brew {{ . | quote }}
{{-   end }}
{{- end }}
{{- if eq .chezmoi.os "darwin" }}
{{-   range .packages.darwin.casks }}
cask {{ . | quote }}
{{-   end }}
{{-   if .work }}
{{-     range .packages.work.casks }}
cask {{ . | quote }}
{{-     end }}
{{-   end }}
{{- end }}
BREWFILE
