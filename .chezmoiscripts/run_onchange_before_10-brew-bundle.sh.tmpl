#!/bin/bash
set -e

eval "$({{ .brewPrefix }}/bin/brew shellenv bash)"

brew bundle --file=/dev/stdin <<BREWFILE
brew "gh"
brew "mise"
brew "openssl@3"
brew "pipx"
brew "tfenv"
brew "uv"
{{- if eq .chezmoi.os "linux" }}
brew "zsh"
{{- end }}
{{- if .work }}

tap "heroku/brew"
brew "astro"
brew "heroku/brew/heroku"
brew "libpq"
{{- end }}
{{- if eq .chezmoi.os "darwin" }}

# Chrome, Slack, Zoom, Claude, and DisplayLink are installed by MDM (Iru Self Service)
tap "anthropics/tap"
brew "dbus"
cask "anthropics/tap/ant"
cask "bruno"
cask "claude-code"
cask "docker-desktop"
cask "ghostty"
cask "obsidian"
cask "scroll-reverser"
cask "visual-studio-code"
{{- if .work }}
cask "gcloud-cli"
cask "ngrok"
{{- end }}
{{- end }}
BREWFILE
